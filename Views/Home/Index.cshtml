@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // If we just submitted the form (skipped loading), ensure we are at the contact section
            const shouldSkip = "@TempData.Peek("SkipLoading")" === "True" || window.PA_SKIP_ANIMATION === true;
            if (shouldSkip && !window.location.hash) {
                const contactSection = document.getElementById('contact');
                if (contactSection) {
                    contactSection.scrollIntoView();
                }
            }

            const wrapper = document.getElementById('splitWrapper');
            const leftPanel = document.getElementById('leftPanel');
            const hint = document.getElementById('mobileHint');
            const images = document.querySelectorAll('.image-container');
            const header = document.getElementById('main-header');

            // Header scroll effect
            window.addEventListener('scroll', () => {
                if (window.scrollY > 50) {
                    header.classList.add('scrolled');
                } else {
                    header.classList.remove('scrolled');
                }
            });

            // Logo click animation
            const logoLink = document.getElementById('logo-link');
            if (logoLink) {
                logoLink.addEventListener('click', (e) => {
                    // Remove the clicked class if it exists to restart animation
                    logoLink.classList.remove('clicked');
                    // Trigger reflow to restart animation
                    void logoLink.offsetWidth;
                    logoLink.classList.add('clicked');
                    
                    // Remove class after animation completes
                    setTimeout(() => {
                        logoLink.classList.remove('clicked');
                    }, 600);
                });
            }

            // Hamburger menu toggle
            const hamburger = document.getElementById('hamburger');
            const navMenu = document.getElementById('nav-menu');
            if (hamburger && navMenu) {
                hamburger.addEventListener('click', () => {
                    hamburger.classList.toggle('active');
                    navMenu.classList.toggle('active');
                });

                // Close menu when a link is clicked
                navMenu.querySelectorAll('a').forEach(link => {
                    link.addEventListener('click', () => {
                        hamburger.classList.remove('active');
                        navMenu.classList.remove('active');
                    });
                });
            }

            let currentX = window.innerWidth / 2;
            let targetX = window.innerWidth / 2;
            let isMobile = window.innerWidth <= 768;

            // Parallax variables
            let targetParallaxX = 0;
            let targetParallaxY = 0;
            let currentParallaxX = 0;
            let currentParallaxY = 0;

            window.addEventListener('resize', () => {
                isMobile = window.innerWidth <= 768;
                leftPanel.style.transition = isMobile ? 'width 0.4s ease-out' : 'none';
            });

            wrapper.addEventListener('mousemove', (e) => {
                if (!isMobile) {
                    targetX = e.clientX;

                    const centerX = window.innerWidth / 2;
                    const centerY = window.innerHeight / 2;
                    targetParallaxX = (e.clientX - centerX) * 0.03;
                    targetParallaxY = (e.clientY - centerY) * 0.03;
                }
            });

            // Mobile tap‑to‑swap
            wrapper.addEventListener('click', () => {
                if (isMobile) {
                    if (hint) hint.style.display = 'none';
                    targetX = (targetX > window.innerWidth / 2) ? 0 : window.innerWidth;
                    leftPanel.style.width = targetX + 'px';
                }
            });

            function animate() {
                if (!isMobile) {
                    currentX += (targetX - currentX) * 0.1;
                    leftPanel.style.width = currentX + 'px';

                    currentParallaxX += (targetParallaxX - currentParallaxX) * 0.08;
                    currentParallaxY += (targetParallaxY - currentParallaxY) * 0.08;
                    
                    // We don't need to force container width here anymore as CSS handles 100vw,
                    // but we do apply the parallax transform to the image or container.
                    images.forEach(container => {
                        container.style.transform = `translate(${currentParallaxX}px, ${currentParallaxY}px)`;
                    });
                }
                requestAnimationFrame(animate);
            }
            animate();
        });
    </script>
}
