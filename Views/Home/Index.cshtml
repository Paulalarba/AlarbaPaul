                        @if (TempData["ContactStatus"] is string contactStatus)
                        {
                            <div class="contact-status" role="status">@contactStatus</div>
                        }

                        <form asp-action="Contact" asp-controller="Home" method="post" class="contact-form">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="contact-validation-summary"></div>

                            <div class="contact-fields">
                                <div class="contact-field">
                                    <label asp-for="Contact.Name"></label>
                                    <input asp-for="Contact.Name" autocomplete="name" />
                                    <span asp-validation-for="Contact.Name"></span>
                                </div>

                                <div class="contact-field">
                                    <label asp-for="Contact.Email"></label>
                                    <input asp-for="Contact.Email" autocomplete="email" />
