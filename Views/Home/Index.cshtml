        <div class="panel-content">
            <div class="text-container">
                <div class="icon-container">
                    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/01/svg"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <!-- Monitor -->
                        <rect x="8" y="16" width="36" height="24" rx="2" stroke="currentColor"/>
                        <path d="M16 40 v 6" stroke="currentColor"/>
                        <path d="M36 40 v 6" stroke="currentColor"/>
                        <path d="M12 46 h 28" stroke="currentColor"/>
                        <!-- Code symbols -->
                        <path d="M16 28 l -4 4 l 4 4" stroke="currentColor"/>
                        <path d="M26 28 l 4 4 l -4 4" stroke="currentColor"/>
                        <path d="M24 24 l -6 14" stroke="currentColor"/>
                        <!-- Database -->
                        <ellipse cx="48" cy="34" rx="10" ry="4" stroke="currentColor" fill="#1b2a38"/>
                        <path d="M38 34 v 12 c 0 2.2 4.5 4 10 4 s 10 -1.8 10 -4 v -12"
                              stroke="currentColor" fill="#1b2a38"/>
                        <path d="M38 40 c 0 2.2 4.5 4 10 4 s 10 -1.8 10 -4"
                              stroke="currentColor"/>
                        <path d="M38 46 c 0 2.2 4.5 4 10 4 s 10 -1.8 10 -4"
                              stroke="currentColor"/>
                    </svg>
                </div>
                <h1 class="main-title">WEB<br>DEVELOPER</h1>
                <p class="sub-text">
                    Delivering interactive experiences with<br>MVC, Razor, and responsive design
                </p>
                <a href="#contact" class="side-btn btn-light">
                    Talk about a build <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>

            <!-- Developer Image -->
            <div class="image-container">
                <img src="/Public/image/ProfileRobotic.png" alt="Developer Paul"
                     class="profile-img" />
            </div>

            <!-- Shapes -->
            <div class="shape circle c2"></div>
            <div class="shape triangle-outline t3">
                <svg viewBox="0 0 24 24"><polygon points="12,2 22,20 2,20"/></svg>
            </div>
            <div class="shape squiggle s1">
                <svg viewBox="0 0 40 40">
                    <path d="M4 36 Q 10 20, 20 28 T 36 12"/>
                </svg>
            </div>
        </div>
    </div>

    <!-- LEFT PANEL (Foreground mask) -->
    <div class="panel panel-left" id="leftPanel">
        <div class="split-line"></div>
        <div class="panel-content">
            <div class="text-container">
                <div class="icon-container">
                    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/01/svg"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <!-- Left node -->
                        <path d="M12 28 l -8 -4 l 8 -4 l 8 4 z" stroke="currentColor"/>
                        <path d="M4 24 v 8 l 8 4 v -8" stroke="currentColor"/>
                        <path d="M20 24 v 8 l -8 4" stroke="currentColor"/>
                        <!-- Top node -->
                        <path d="M28 16 l -8 -4 l 8 -4 l 8 4 z" stroke="currentColor"/>
                        <path d="M20 12 v 8 l 8 4 v -8" stroke="currentColor"/>
                        <path d="M36 12 v 8 l -8 4" stroke="currentColor"/>
                        <!-- Right node (with lock) -->
                        <path d="M44 28 l -8 -4 l 8 -4 l 8 4 z" stroke="currentColor"/>
                        <path d="M36 24 v 12 l 8 4 v -12" stroke="currentColor"/>
                        <path d="M52 24 v 12 l -8 4" stroke="currentColor"/>
                        <!-- Connections -->
                        <path d="M16 22 l 8 -6" stroke="currentColor"/>
                        <path d="M32 22 l 8 -6" stroke="currentColor"/>
                        <path d="M12 36 v 12" stroke="currentColor"/>
                        <!-- Bottom Node -->
                        <path d="M12 56 l -8 -4 l 8 -4 l 8 4 z" stroke="currentColor"/>
                        <path d="M4 52 v 8 l 8 4 v -8" stroke="currentColor"/>
                        <path d="M20 52 v 8 l -8 4" stroke="currentColor"/>
                        <!-- Lock icon -->
                        <rect x="40" y="32" width="8" height="6" rx="1"
                              fill="white" stroke="currentColor"/>
                        <path d="M42 32 v -2 a 2 2 0 0 1 4 0 v 2"
                              stroke="currentColor"/>
                        <circle cx="44" cy="35" r="1"
                                fill="currentColor" stroke="none"/>
                    </svg>
                </div>
                <h1 class="main-title">BLOCKCHAIN<br>INNOVATOR</h1>
                <p class="sub-text">
                    Building secure, decentralized solutions<br>
                    with smart contracts and Web3
                </p>
                <a href="#work" class="side-btn btn-dark">
                    View blockchain work <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>

            <!-- Designer Image -->
            <div class="image-container">
                <img src="/Public/image/Profile.png" alt="Designer Paul"
                     class="profile-img" />
            </div>

            <!-- Shapes -->
            <div class="shape circle c1"></div>
            <div class="shape triangle-outline t1">
                <svg viewBox="0 0 24 24"><polygon points="12,2 22,20 2,20"/></svg>
            </div>
            <div class="shape line l1"></div>
            <div class="shape triangle-outline t2">
                <svg viewBox="0 0 24 24"><polygon points="12,2 22,20 2,20"/></svg>
            </div>
        </div>
    </div>
</div>

<!-- ABOUT SECTION -->
<section id="about" class="about-section">
    <div class="container">
        <div class="about-intro section-reveal">
            <h2>I'm a Back-end and Blockchain Developer based in sunny Cebu, Philippines.</h2>
            <p>
                Since I started my journey in tech, I've enjoyed turning complex logic into simple, 
                beautiful and intuitive systems. When I'm not writing code, you'll find me cooking, 
                gardening or working out in the park.
            </p>
        </div>

        <h3 class="section-subtitle">Tech-stack</h3>
        <div class="about-columns section-reveal">
            <div class="about-col">
                <h3 class="about-col-title">Part Back-end</h3>
                <ul class="about-list">
                    <li><i class="fa-brands fa-dot-net icon-dotnet"></i> ASP.NET Core MVC</li>
                    <li><i class="fa-solid fa-layer-group icon-arch"></i> Entity Framework</li>
                    <li><i class="fa-solid fa-database icon-db"></i> PostgreSQL / SQL Server</li>
                    <li><i class="fa-solid fa-sitemap icon-arch"></i> Clean Architecture</li>
                    <li><i class="fa-solid fa-compass-drafting icon-design"></i> Design Systems</li>
                </ul>
            </div>
            <div class="about-col">
                <h3 class="about-col-title">Part Front-end</h3>
                <ul class="about-list">
                    <li><i class="fa-brands fa-html5 icon-html"></i> HTML / CSS</li>
                    <li><i class="fa-brands fa-react icon-react"></i> React</li>
                    <li><i class="fa-solid fa-wind icon-tailwind"></i> Tailwind CSS</li>
                    <li><i class="fa-brands fa-bootstrap icon-bootstrap"></i> Bootstrap</li>
                    <li><i class="fa-solid fa-code icon-razor"></i> Razor Views</li>
                    <li><i class="fa-brands fa-js icon-web3"></i> JavaScript / jQuery</li>
                </ul>
            </div>
            <div class="about-col">
                <h3 class="about-col-title">Part Blockchain</h3>
                <ul class="about-list">
                    <li><i class="fa-solid fa-file-code icon-solidity"></i> Solidity / Contracts</li>
                    <li><i class="fa-brands fa-ethereum icon-eth"></i> Web3.js / Ethers.js</li>
                    <li><i class="fa-solid fa-circle-nodes icon-polkadot"></i> Polkadot / Substrate</li>
                    <li><i class="fa-brands fa-ethereum icon-eth"></i> Ethereum Ecosystem</li>
                    <li><i class="fa-solid fa-hammer icon-hardhat"></i> Hardhat / Truffle</li>
                </ul>
            </div>
        </div>

        <div id="work" class="about-projects section-reveal">
            <h3 class="section-subtitle">Featured Projects</h3>
            <div class="projects-grid">
                <!-- Project 1 -->
                <div class="project-card">
                    <div class="project-image">
                        <img src="/Public/image/ProjectFitTrack.png" alt="FitTrack Project">
                    </div>
                    <div class="project-info">
                        <h4>FitTrack</h4>
                        <p>A comprehensive fitness tracking application built with ASP.NET Core MVC and PostgreSQL, featuring workout logging and progress visualization.</p>
                        <div class="project-tags">
                            <span class="project-tag">ASP.NET Core</span>
                            <span class="project-tag">MVC</span>
                            <span class="project-tag">PostgreSQL</span>
                            <span class="project-tag">Entity Framework</span>
                        </div>
                    </div>
                </div>

                <!-- Project 2 (Placeholder) -->
                <div class="project-card">
                    <div class="project-image" style="background: #e2e8f0; display:flex; align-items:center; justify-content:center;">
                        <i class="fa-solid fa-link" style="font-size: 3rem; color: #94a3b8;"></i>
                    </div>
                    <div class="project-info">
                        <h4>Decentralized Voting</h4>
                        <p>A secure blockchain-based voting system using Solidity smart contracts on the Ethereum network to ensure transparency and immutability.</p>
                        <div class="project-tags">
                            <span class="project-tag">Solidity</span>
                            <span class="project-tag">Web3.js</span>
                            <span class="project-tag">Ethereum</span>
                        </div>
                    </div>
                </div>

                <!-- Project 3 (Placeholder) -->
                <div class="project-card">
                    <div class="project-image" style="background: #e2e8f0; display:flex; align-items:center; justify-content:center;">
                        <i class="fa-solid fa-shop" style="font-size: 3rem; color: #94a3b8;"></i>
                    </div>
                    <div class="project-info">
                        <h4>PolkaMarket</h4>
                        <p>An NFT marketplace prototype built on the Polkadot ecosystem, exploring cross-chain interoperability and digital asset management.</p>
                        <div class="project-tags">
                            <span class="project-tag">Polkadot</span>
                            <span class="project-tag">Substrate</span>
                            <span class="project-tag">Rust</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const wrapper = document.getElementById('splitWrapper');
            const leftPanel = document.getElementById('leftPanel');
            const hint = document.getElementById('mobileHint');
            const images = document.querySelectorAll('.image-container');
            const header = document.getElementById('main-header');

            // Header scroll effect
            window.addEventListener('scroll', () => {
                if (window.scrollY > 50) {
                    header.classList.add('scrolled');
                } else {
                    header.classList.remove('scrolled');
                }
            });

            let currentX = window.innerWidth / 2;
            let targetX = window.innerWidth / 2;
            let isMobile = window.innerWidth <= 768;

            // Parallax variables
            let targetParallaxX = 0;
            let targetParallaxY = 0;
            let currentParallaxX = 0;
            let currentParallaxY = 0;

            window.addEventListener('resize', () => {
                isMobile = window.innerWidth <= 768;
                leftPanel.style.transition = isMobile ? 'width 0.4s ease-out' : 'none';
            });

            wrapper.addEventListener('mousemove', (e) => {
                if (!isMobile) {
                    targetX = e.clientX;

                    const centerX = window.innerWidth / 2;
                    const centerY = window.innerHeight / 2;
                    targetParallaxX = (e.clientX - centerX) * 0.03;
                    targetParallaxY = (e.clientY - centerY) * 0.03;
                }
            });

            // Mobile tap‑to‑swap
            wrapper.addEventListener('click', () => {
                if (isMobile) {
                    if (hint) hint.style.display = 'none';
                    targetX = (targetX > window.innerWidth / 2) ? 0 : window.innerWidth;
                    leftPanel.style.width = targetX + 'px';
                }
            });

            function animate() {
                if (!isMobile) {
                    currentX += (targetX - currentX) * 0.1;
                    leftPanel.style.width = currentX + 'px';

                    currentParallaxX += (targetParallaxX - currentParallaxX) * 0.08;
                    currentParallaxY += (targetParallaxY - currentParallaxY) * 0.08;
                    
                    // We don't need to force container width here anymore as CSS handles 100vw,
                    // but we do apply the parallax transform to the image or container.
                    images.forEach(container => {
                        container.style.transform = `translate(${currentParallaxX}px, ${currentParallaxY}px)`;
                    });
                }
                requestAnimationFrame(animate);
            }
            animate();
        });
    </script>
}