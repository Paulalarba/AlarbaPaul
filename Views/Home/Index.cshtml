@{
    ViewData["Title"] = "Portfolio";
}
<header id="main-header">
    <div class="nav-container">
        <a href="/" class="logo">Paul<span>Alarba</span></a>
        <nav class="nav-menu">
            <a href="#about">About</a>
            <a href="#work">Work</a>
            <a href="#skills">Skills</a>
            <a href="#contact">Contact</a>
        </nav>
        <a href="#contact" class="cta-btn">Start a project</a>
    </div>
</header>

<div class="split-wrapper" id="splitWrapper">
    <div class="mobile-hint" id="mobileHint">Tap screen to swap roles</div>

    <!-- RIGHT PANEL (Background) -->
    <div class="panel panel-right">
        <div class="panel-content">
            <div class="text-container">
                <div class="icon-container">
                    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/01/svg"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <!-- Monitor -->
                        <rect x="8" y="16" width="36" height="24" rx="2" stroke="currentColor"/>
                        <path d="M16 40 v 6" stroke="currentColor"/>
                        <path d="M36 40 v 6" stroke="currentColor"/>
                        <path d="M12 46 h 28" stroke="currentColor"/>
                        <!-- Code symbols -->
                        <path d="M16 28 l -4 4 l 4 4" stroke="currentColor"/>
                        <path d="M26 28 l 4 4 l -4 4" stroke="currentColor"/>
                        <path d="M24 24 l -6 14" stroke="currentColor"/>
                        <!-- Database -->
                        <ellipse cx="48" cy="34" rx="10" ry="4" stroke="currentColor" fill="#1b2a38"/>
                        <path d="M38 34 v 12 c 0 2.2 4.5 4 10 4 s 10 -1.8 10 -4 v -12"
                              stroke="currentColor" fill="#1b2a38"/>
                        <path d="M38 40 c 0 2.2 4.5 4 10 4 s 10 -1.8 10 -4"
                              stroke="currentColor"/>
                        <path d="M38 46 c 0 2.2 4.5 4 10 4 s 10 -1.8 10 -4"
                              stroke="currentColor"/>
                    </svg>
                </div>
                <h1 class="main-title">WEB<br>DEVELOPER</h1>
                <p class="sub-text">
                    Delivering interactive experiences with<br>MVC, Razor, and responsive design
                </p>
                <a href="#contact" class="side-btn btn-light">
                    Talk about a build <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>

            <!-- Developer Image -->
            <div class="image-container">
                <img src="/Public/image/ProfileRobotic.png" alt="Developer Paul"
                     class="profile-img" />
            </div>

            <!-- Shapes -->
            <div class="shape circle c2"></div>
            <div class="shape triangle-outline t3">
                <svg viewBox="0 0 24 24"><polygon points="12,2 22,20 2,20"/></svg>
            </div>
            <div class="shape squiggle s1">
                <svg viewBox="0 0 40 40">
                    <path d="M4 36 Q 10 20, 20 28 T 36 12"/>
                </svg>
            </div>
        </div>
    </div>

    <!-- LEFT PANEL (Foreground mask) -->
    <div class="panel panel-left" id="leftPanel">
        <div class="split-line"></div>
        <div class="panel-content">
            <div class="text-container">
                <div class="icon-container">
                    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/01/svg"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <!-- Left node -->
                        <path d="M12 28 l -8 -4 l 8 -4 l 8 4 z" stroke="currentColor"/>
                        <path d="M4 24 v 8 l 8 4 v -8" stroke="currentColor"/>
                        <path d="M20 24 v 8 l -8 4" stroke="currentColor"/>
                        <!-- Top node -->
                        <path d="M28 16 l -8 -4 l 8 -4 l 8 4 z" stroke="currentColor"/>
                        <path d="M20 12 v 8 l 8 4 v -8" stroke="currentColor"/>
                        <path d="M36 12 v 8 l -8 4" stroke="currentColor"/>
                        <!-- Right node (with lock) -->
                        <path d="M44 28 l -8 -4 l 8 -4 l 8 4 z" stroke="currentColor"/>
                        <path d="M36 24 v 12 l 8 4 v -12" stroke="currentColor"/>
                        <path d="M52 24 v 12 l -8 4" stroke="currentColor"/>
                        <!-- Connections -->
                        <path d="M16 22 l 8 -6" stroke="currentColor"/>
                        <path d="M32 22 l 8 -6" stroke="currentColor"/>
                        <path d="M12 36 v 12" stroke="currentColor"/>
                        <!-- Bottom Node -->
                        <path d="M12 56 l -8 -4 l 8 -4 l 8 4 z" stroke="currentColor"/>
                        <path d="M4 52 v 8 l 8 4 v -8" stroke="currentColor"/>
                        <path d="M20 52 v 8 l -8 4" stroke="currentColor"/>
                        <!-- Lock icon -->
                        <rect x="40" y="32" width="8" height="6" rx="1"
                              fill="white" stroke="currentColor"/>
                        <path d="M42 32 v -2 a 2 2 0 0 1 4 0 v 2"
                              stroke="currentColor"/>
                        <circle cx="44" cy="35" r="1"
                                fill="currentColor" stroke="none"/>
                    </svg>
                </div>
                <h1 class="main-title">BLOCKCHAIN<br>INNOVATOR</h1>
                <p class="sub-text">
                    Building secure, decentralized solutions<br>
                    with smart contracts and Web3
                </p>
                <a href="#work" class="side-btn btn-dark">
                    View blockchain work <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>

            <!-- Designer Image -->
            <div class="image-container">
                <img src="/Public/image/Profile.png" alt="Designer Paul"
                     class="profile-img" />
            </div>

            <!-- Shapes -->
            <div class="shape circle c1"></div>
            <div class="shape triangle-outline t1">
                <svg viewBox="0 0 24 24"><polygon points="12,2 22,20 2,20"/></svg>
            </div>
            <div class="shape line l1"></div>
            <div class="shape triangle-outline t2">
                <svg viewBox="0 0 24 24"><polygon points="12,2 22,20 2,20"/></svg>
            </div>
        </div>
    </div>
</div>

<!-- ABOUT SECTION -->
<section id="about" class="about-section">
    <div class="container">
        <div class="section-header">
            <span class="section-num">01.</span>
            <h2 class="section-title">About Me</h2>
            <div class="section-line"></div>
        </div>

        <div class="about-grid">
            <div class="about-left">
                <h3 class="subsection-title">
                    <i class="fa-regular fa-user text-accent"></i> Background
                </h3>
                <p>
                    Currently a <span class="text-accent">3rd Year BSIT student</span> at the
                    <strong>University of Cebu</strong>. I have <span class="text-accent">2+ years</span>
                    of programming experience through internships, hackathons, personal projects,
                    and work for organizations.
                </p>
                <p>
                    I believe code should be as <strong>maintainable as it is functional</strong>.
                    By prioritizing <strong>modular, reusable code practices</strong>, I
                    <span class="text-accent">accelerate the path from concept to production</span>,
                    delivering <strong>scalable, heavily‑functional systems</strong> that are
                    <strong>built to last</strong>. I thrive on the challenge of integrating
                    <strong>AI/ML</strong> to transform standard applications into
                    <strong>smart, competitive products</strong>.
                </p>
                <p>
                    I love programming because it is a <strong>craft</strong> wherein you build
                    products to create <strong>real‑world solutions</strong>.
                </p>
            </div>
            <div class="about-right">
                <h3 class="subsection-title">
                    <i class="fa-solid fa-code text-accent"></i> Tech Stack
                </h3>
                <div class="tech-chips">
                    <span class="chip"><i class="fa-brands fa-js tech-icon ts-color"></i> TypeScript</span>
                    <span class="chip"><i class="fa-brands fa-react tech-icon react-color"></i> React</span>
                    <span class="chip"><i class="fa-brands fa-node-js tech-icon node-color"></i> Node.js</span>
                    <span class="chip"><i class="fa-brands fa-node tech-icon"></i> Express</span>
                    <span class="chip"><i class="fa-brands fa-envira tech-icon mongo-color"></i> MongoDB</span>
                    <span class="chip"><i class="fa-solid fa-database tech-icon pg-color"></i> PostgreSQL</span>
                    <span class="chip"><i class="fa-solid fa-wind tech-icon tailwind-color"></i> Tailwind</span>
                    <span class="chip"><i class="fa-brands fa-figma tech-icon framer-color"></i> Framer</span>
                </div>

                <h3 class="subsection-title mt-2rem">
                    <i class="fa-solid fa-bolt text-accent"></i> Currently Learning
                </h3>
                <ul class="learning-list">
                    <li>Next.js</li>
                    <li>Relational Database Design</li>
                    <li>Cloud Services</li>
                    <li>AI/ML Integration</li>
                </ul>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const wrapper = document.getElementById('splitWrapper');
            const leftPanel = document.getElementById('leftPanel');
            const hint = document.getElementById('mobileHint');
            const images = document.querySelectorAll('.profile-img');
            const header = document.getElementById('main-header');

            // Header scroll effect
            window.addEventListener('scroll', () => {
                if (window.scrollY > 50) {
                    header.classList.add('scrolled');
                } else {
                    header.classList.remove('scrolled');
                }
            });

            let currentX = window.innerWidth / 2;
            let targetX = window.innerWidth / 2;
            let isMobile = window.innerWidth <= 768;

            // Parallax variables
            let targetParallaxX = 0;
            let targetParallaxY = 0;
            let currentParallaxX = 0;
            let currentParallaxY = 0;

            window.addEventListener('resize', () => {
                isMobile = window.innerWidth <= 768;
                leftPanel.style.transition = isMobile ? 'width 0.4s ease-out' : 'none';
            });

            wrapper.addEventListener('mousemove', (e) => {
                if (!isMobile) {
                    targetX = e.clientX;

                    const centerX = window.innerWidth / 2;
                    const centerY = window.innerHeight / 2;
                    targetParallaxX = (e.clientX - centerX) * 0.03;
                    targetParallaxY = (e.clientY - centerY) * 0.03;
                }
            });

            // Mobile tap‑to‑swap
            wrapper.addEventListener('click', () => {
                if (isMobile) {
                    if (hint) hint.style.display = 'none';
                    targetX = (targetX > window.innerWidth / 2) ? 0 : window.innerWidth;
                    leftPanel.style.width = targetX + 'px';
                }
            });

            function animate() {
                if (!isMobile) {
                    currentX += (targetX - currentX) * 0.04;
                    leftPanel.style.width = currentX + 'px';

                    currentParallaxX += (targetParallaxX - currentParallaxX) * 0.05;
                    currentParallaxY += (targetParallaxY - currentParallaxY) * 0.05;
                    images.forEach(img => {
                        img.style.transform = `translate(${currentParallaxX}px, ${currentParallaxY}px)`;
                    });
                }
                requestAnimationFrame(animate);
            }
            animate();
        });
    </script>
}