@{
    ViewData["Title"] = "Home Page";
}

<div class="noise-layer" aria-hidden="true"></div>

<!-- Sticky Navigation -->
<header id="site-header" class="fixed left-0 top-0 z-50 w-full border-b border-white/10 bg-ink/82 backdrop-blur-md">
  <nav class="mx-auto flex h-[var(--nav-height)] max-w-7xl items-center justify-between px-5 sm:px-6 lg:px-8" aria-label="Primary navigation">
    <a href="#home" class="group inline-flex items-center gap-3" aria-label="Paul Alarba home">
      <span class="flex h-10 w-10 items-center justify-center rounded border border-cyan/35 bg-cyan/10 font-mono text-sm font-semibold text-cyan shadow-glow">
        PA
      </span>
      <span class="hidden text-sm font-semibold tracking-wide text-slate-100 sm:inline">Paul Alarba</span>
    </a>

    <div class="hidden items-center gap-8 md:flex">
      <a href="#home" class="nav-link text-sm font-semibold uppercase tracking-[0.18em]">Home</a>
      <a href="#about" class="nav-link text-sm font-semibold uppercase tracking-[0.18em]">About</a>
      <a href="#projects" class="nav-link text-sm font-semibold uppercase tracking-[0.18em]">Projects</a>
      <a href="#contact" class="nav-link text-sm font-semibold uppercase tracking-[0.18em]">Contact</a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="inline-flex min-h-11 min-w-11 items-center justify-center rounded border border-white/15 bg-white/5 text-slate-100 transition hover:border-cyan/45 hover:text-cyan md:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Open navigation menu"
    >
      <i class="fa-solid fa-bars" aria-hidden="true"></i>
    </button>
  </nav>

  <div id="mobile-menu" class="mobile-menu border-t border-white/10 bg-ink/96 md:hidden">
    <div class="mx-auto grid max-w-7xl gap-1 px-5 py-4">
      <a href="#home" class="mobile-nav-link rounded px-3 py-3 text-sm font-semibold uppercase tracking-[0.18em] text-slate-200 hover:bg-white/5 hover:text-cyan">Home</a>
      <a href="#about" class="mobile-nav-link rounded px-3 py-3 text-sm font-semibold uppercase tracking-[0.18em] text-slate-200 hover:bg-white/5 hover:text-cyan">About</a>
      <a href="#projects" class="mobile-nav-link rounded px-3 py-3 text-sm font-semibold uppercase tracking-[0.18em] text-slate-200 hover:bg-white/5 hover:text-cyan">Projects</a>
      <a href="#contact" class="mobile-nav-link rounded px-3 py-3 text-sm font-semibold uppercase tracking-[0.18em] text-slate-200 hover:bg-white/5 hover:text-cyan">Contact</a>
    </div>
  </div>
</header>

<main>
  <!-- Hero -->
  <section id="home" class="relative flex min-h-screen items-center px-5 pb-20 pt-32 sm:px-6 lg:px-8">
    <div class="mx-auto grid w-full max-w-7xl items-center gap-12 lg:grid-cols-[1.08fr_0.92fr]">
      <div class="section-reveal">
        <p class="mb-5 font-mono text-sm font-semibold uppercase tracking-[0.28em] text-cyan">
          Full-stack developer
        </p>

        <h1 class="max-w-5xl text-5xl font-black leading-[0.96] tracking-normal text-slate-50 sm:text-6xl lg:text-7xl">
          Paul Alarba
          <span class="mt-4 block text-3xl font-extrabold leading-tight text-slate-300 sm:text-4xl lg:text-5xl">
            From first line of code to full-stack craft: building systems that feel human.
          </span>
        </h1>

        <p class="mt-7 max-w-2xl text-lg font-medium leading-8 text-slate-300 sm:text-xl">
          I design and build practical web experiences with ASP.NET Core, clean interfaces, and a bias for clarity.
          My work lives where strong engineering meets thoughtful storytelling.
        </p>

        <div class="mt-9 flex flex-col gap-4 sm:flex-row">
          <a href="#projects" class="inline-flex min-h-12 items-center justify-center rounded border border-cyan/60 bg-cyan px-6 py-3 text-sm font-extrabold uppercase tracking-[0.14em] text-ink shadow-glow transition hover:-translate-y-1 hover:bg-cyan/90 focus:outline-none focus:ring-2 focus:ring-cyan focus:ring-offset-2 focus:ring-offset-ink">
            View My Work
          </a>
          <a href="#contact" class="inline-flex min-h-12 items-center justify-center rounded border border-white/18 bg-white/5 px-6 py-3 text-sm font-extrabold uppercase tracking-[0.14em] text-slate-100 transition hover:-translate-y-1 hover:border-violet/60 hover:text-violet focus:outline-none focus:ring-2 focus:ring-violet focus:ring-offset-2 focus:ring-offset-ink">
            Let's Talk
          </a>
        </div>
      </div>

      <aside class="section-reveal rounded border border-white/12 bg-panel/80 p-4 shadow-violetGlow">
        <div class="rounded border border-white/10 bg-[#090a0d]">
          <div class="flex items-center gap-2 border-b border-white/10 px-4 py-3">
            <span class="h-3 w-3 rounded-full bg-[#ff6b6b]"></span>
            <span class="h-3 w-3 rounded-full bg-[#ffcf5a]"></span>
            <span class="h-3 w-3 rounded-full bg-[#38f5a8]"></span>
            <span class="ml-3 font-mono text-xs text-slate-400">journey.cs</span>
          </div>

          <div class="space-y-3 overflow-hidden p-5 font-mono text-sm leading-7 text-slate-300 sm:text-base">
            <p class="code-window-line" data-line="01"><span class="text-violet">public</span> <span class="text-cyan">class</span> Developer</p>
            <p class="code-window-line" data-line="02">{</p>
            <p class="code-window-line" data-line="03">  Name = <span class="text-ember">"Paul Alarba"</span>;</p>
            <p class="code-window-line" data-line="04">  Stack = <span class="text-ember">".NET + Web UI"</span>;</p>
            <p class="code-window-line" data-line="05">  Focus = <span class="text-ember">"Useful software"</span>;</p>
            <p class="code-window-line" data-line="06">  Build(<span class="text-mint">clarity</span>, <span class="text-mint">speed</span>, <span class="text-mint">care</span>);</p>
            <p class="code-window-line" data-line="07">}</p>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="px-5 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[0.92fr_1.08fr]">
      <div class="section-reveal order-2 lg:order-1">
        <div class="relative mx-auto aspect-[4/5] max-w-sm overflow-hidden rounded border border-white/12 bg-white/5 shadow-glow">
          <img
            src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=900&q=80"
            alt="Developer workspace placeholder for Paul Alarba"
            class="h-full w-full object-cover opacity-80"
          />
          <div class="absolute inset-x-0 bottom-0 border-t border-white/10 bg-ink/86 p-5 backdrop-blur-sm">
            <p class="font-mono text-xs uppercase tracking-[0.22em] text-cyan">Profile image placeholder</p>
            <p class="mt-2 text-sm font-medium text-slate-300">Replace with a professional portrait or branded avatar.</p>
          </div>
        </div>
      </div>

      <div class="section-reveal order-1 lg:order-2">
        <p class="font-mono text-sm font-semibold uppercase tracking-[0.28em] text-violet">The Journey</p>
        <h2 class="mt-4 text-4xl font-black tracking-normal text-slate-50 sm:text-5xl">My Story</h2>

        <div class="mt-7 max-w-prose space-y-5 text-base font-medium leading-8 text-slate-300 sm:text-lg">
          <p>
            My path into development started with curiosity: one line, one bug, one small win at a time.
            Over time, that curiosity became a craft: building applications that make information easier to use and workflows easier to trust.
          </p>
          <p>
            I care about the full shape of a product, from database structure and backend reliability to the details people feel on the screen.
            Good software should be understandable, durable, and quietly helpful.
          </p>
          <p id="story-extra" class="hidden">
            Today, I focus on ASP.NET Core MVC, Entity Framework Core, JavaScript, and responsive UI systems.
            I am driven by projects where the engineering is solid and the experience has a pulse.
          </p>
        </div>

        <button
          id="story-toggle"
          type="button"
          class="mt-7 inline-flex min-h-11 items-center gap-3 rounded border border-white/15 px-5 py-3 text-sm font-bold uppercase tracking-[0.14em] text-slate-100 transition hover:border-cyan/50 hover:text-cyan focus:outline-none focus:ring-2 focus:ring-cyan focus:ring-offset-2 focus:ring-offset-ink"
          aria-expanded="false"
        >
          <span>Read Full Story</span>
          <i class="fa-solid fa-arrow-right-long" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="px-5 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="section-reveal max-w-3xl">
        <p class="font-mono text-sm font-semibold uppercase tracking-[0.28em] text-cyan">Selected Work</p>
        <h2 class="mt-4 text-4xl font-black tracking-normal text-slate-50 sm:text-5xl">Projects built with purpose.</h2>
        <p class="mt-5 text-lg font-medium leading-8 text-slate-300">
          A placeholder collection for the MVC-backed project list. Each card can become a Razor partial later.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        <article class="section-reveal hover-glow overflow-hidden rounded border border-white/12 bg-panel">
          <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=900&q=80" alt="Code editor project placeholder" class="h-48 w-full object-cover opacity-85" />
          <div class="p-6">
            <h3 class="text-xl font-extrabold text-slate-50">Portfolio MVC Platform</h3>
            <p class="mt-3 min-h-20 text-sm font-medium leading-7 text-slate-300">
              A content-ready portfolio system prepared for projects, testimonials, and contact messages.
            </p>
            <div class="mt-5 flex flex-wrap gap-2">
              <span class="rounded-full bg-cyan/10 px-3 py-1 font-mono text-xs text-cyan">ASP.NET Core</span>
              <span class="rounded-full bg-white/8 px-3 py-1 font-mono text-xs text-slate-300">MVC</span>
            </div>
            <a href="#" class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-cyan hover:text-slate-50">
              View Case Study <i class="fa-solid fa-arrow-right-long" aria-hidden="true"></i>
            </a>
          </div>
        </article>

        <article class="section-reveal hover-glow overflow-hidden rounded border border-white/12 bg-panel">
          <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=900&q=80" alt="Analytics dashboard placeholder" class="h-48 w-full object-cover opacity-85" />
          <div class="p-6">
            <h3 class="text-xl font-extrabold text-slate-50">Data Dashboard</h3>
            <p class="mt-3 min-h-20 text-sm font-medium leading-7 text-slate-300">
              A responsive dashboard concept for viewing metrics, records, and operational insights.
            </p>
            <div class="mt-5 flex flex-wrap gap-2">
              <span class="rounded-full bg-violet/10 px-3 py-1 font-mono text-xs text-violet">SQL</span>
              <span class="rounded-full bg-white/8 px-3 py-1 font-mono text-xs text-slate-300">EF Core</span>
            </div>
            <a href="#" class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-cyan hover:text-slate-50">
              Learn More <i class="fa-solid fa-arrow-right-long" aria-hidden="true"></i>
            </a>
          </div>
        </article>

        <article class="section-reveal hover-glow overflow-hidden rounded border border-white/12 bg-panel">
          <img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=900&q=80" alt="Laptop development project placeholder" class="h-48 w-full object-cover opacity-85" />
          <div class="p-6">
            <h3 class="text-xl font-extrabold text-slate-50">Booking Workflow</h3>
            <p class="mt-3 min-h-20 text-sm font-medium leading-7 text-slate-300">
              A structured booking interface concept with clean states and mobile-first interactions.
            </p>
            <div class="mt-5 flex flex-wrap gap-2">
              <span class="rounded-full bg-mint/10 px-3 py-1 font-mono text-xs text-mint">JavaScript</span>
              <span class="rounded-full bg-white/8 px-3 py-1 font-mono text-xs text-slate-300">Tailwind</span>
            </div>
            <a href="#" class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-cyan hover:text-slate-50">
              View Case Study <i class="fa-solid fa-arrow-right-long" aria-hidden="true"></i>
            </a>
          </div>
        </article>

        <article class="section-reveal hover-glow overflow-hidden rounded border border-white/12 bg-panel">
          <img src="https://images.unsplash.com/photo-1515879218367-8466d910aaa4?auto=format&fit=crop&w=900&q=80" alt="Terminal code placeholder" class="h-48 w-full object-cover opacity-85" />
          <div class="p-6">
            <h3 class="text-xl font-extrabold text-slate-50">API Integration Kit</h3>
            <p class="mt-3 min-h-20 text-sm font-medium leading-7 text-slate-300">
              A backend-focused project placeholder for services, validation, and API-ready architecture.
            </p>
            <div class="mt-5 flex flex-wrap gap-2">
              <span class="rounded-full bg-ember/10 px-3 py-1 font-mono text-xs text-ember">C#</span>
              <span class="rounded-full bg-white/8 px-3 py-1 font-mono text-xs text-slate-300">REST</span>
            </div>
            <a href="#" class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-cyan hover:text-slate-50">
              Learn More <i class="fa-solid fa-arrow-right-long" aria-hidden="true"></i>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section id="skills" class="px-5 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="section-reveal max-w-3xl">
        <p class="font-mono text-sm font-semibold uppercase tracking-[0.28em] text-violet">Toolkit</p>
        <h2 class="mt-4 text-4xl font-black tracking-normal text-slate-50 sm:text-5xl">Skills and technologies.</h2>
      </div>

      <div class="section-reveal mt-10 flex flex-wrap gap-3">
        <span class="rounded-full border border-white/12 bg-white/7 px-4 py-2 font-mono text-sm font-semibold text-slate-200 transition hover:border-cyan/50 hover:bg-cyan/12 hover:text-cyan">C#</span>
        <span class="rounded-full border border-white/12 bg-white/7 px-4 py-2 font-mono text-sm font-semibold text-slate-200 transition hover:border-cyan/50 hover:bg-cyan/12 hover:text-cyan">.NET</span>
        <span class="rounded-full border border-white/12 bg-white/7 px-4 py-2 font-mono text-sm font-semibold text-slate-200 transition hover:border-cyan/50 hover:bg-cyan/12 hover:text-cyan">ASP.NET Core</span>
        <span class="rounded-full border border-white/12 bg-white/7 px-4 py-2 font-mono text-sm font-semibold text-slate-200 transition hover:border-cyan/50 hover:bg-cyan/12 hover:text-cyan">Entity Framework Core</span>
        <span class="rounded-full border border-white/12 bg-white/7 px-4 py-2 font-mono text-sm font-semibold text-slate-200 transition hover:border-cyan/50 hover:bg-cyan/12 hover:text-cyan">SQL</span>
        <span class="rounded-full border border-white/12 bg-white/7 px-4 py-2 font-mono text-sm font-semibold text-slate-200 transition hover:border-cyan/50 hover:bg-cyan/12 hover:text-cyan">JavaScript</span>
        <span class="rounded-full border border-white/12 bg-white/7 px-4 py-2 font-mono text-sm font-semibold text-slate-200 transition hover:border-cyan/50 hover:bg-cyan/12 hover:text-cyan">Tailwind CSS</span>
        <span class="rounded-full border border-white/12 bg-white/7 px-4 py-2 font-mono text-sm font-semibold text-slate-200 transition hover:border-cyan/50 hover:bg-cyan/12 hover:text-cyan">HTML5</span>
        <span class="rounded-full border border-white/12 bg-white/7 px-4 py-2 font-mono text-sm font-semibold text-slate-200 transition hover:border-cyan/50 hover:bg-cyan/12 hover:text-cyan">CSS3</span>
        <span class="rounded-full border border-white/12 bg-white/7 px-4 py-2 font-mono text-sm font-semibold text-slate-200 transition hover:border-cyan/50 hover:bg-cyan/12 hover:text-cyan">Git</span>
        <span class="rounded-full border border-white/12 bg-white/7 px-4 py-2 font-mono text-sm font-semibold text-slate-200 transition hover:border-cyan/50 hover:bg-cyan/12 hover:text-cyan">Razor Views</span>
        <span class="rounded-full border border-white/12 bg-white/7 px-4 py-2 font-mono text-sm font-semibold text-slate-200 transition hover:border-cyan/50 hover:bg-cyan/12 hover:text-cyan">Responsive UI</span>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="px-5 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.88fr_1.12fr]">
      <div class="section-reveal">
        <p class="font-mono text-sm font-semibold uppercase tracking-[0.28em] text-cyan">Say Hello</p>
        <h2 class="mt-4 text-4xl font-black tracking-normal text-slate-50 sm:text-5xl">Let's Talk</h2>
        <p class="mt-5 max-w-prose text-lg font-medium leading-8 text-slate-300">
          Have a project in mind or just want to connect? Reach out.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#" class="inline-flex min-h-12 min-w-12 items-center justify-center rounded border border-white/15 bg-white/5 text-xl text-slate-100 transition hover:border-cyan/50 hover:text-cyan" aria-label="GitHub">
            <i class="fab fa-github" aria-hidden="true"></i>
          </a>
          <a href="#" class="inline-flex min-h-12 min-w-12 items-center justify-center rounded border border-white/15 bg-white/5 text-xl text-slate-100 transition hover:border-cyan/50 hover:text-cyan" aria-label="LinkedIn">
            <i class="fab fa-linkedin-in" aria-hidden="true"></i>
          </a>
          <a href="#" class="inline-flex min-h-12 min-w-12 items-center justify-center rounded border border-white/15 bg-white/5 text-xl text-slate-100 transition hover:border-cyan/50 hover:text-cyan" aria-label="X or Twitter">
            <i class="fab fa-x-twitter" aria-hidden="true"></i>
          </a>
          <a href="mailto:hello@example.com" class="inline-flex min-h-12 items-center gap-3 rounded border border-white/15 bg-white/5 px-4 text-sm font-bold text-slate-100 transition hover:border-violet/50 hover:text-violet">
            <i class="fa-solid fa-envelope" aria-hidden="true"></i>
            <span>hello@example.com</span>
          </a>
        </div>
      </div>

      <form id="contact-form" class="section-reveal rounded border border-white/12 bg-panel p-5 shadow-glow sm:p-7">
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block">
            <span class="text-sm font-bold text-slate-200">Name</span>
            <input
              type="text"
              name="name"
              placeholder="Your name"
              class="mt-2 min-h-12 w-full rounded border border-white/15 bg-black/40 px-4 text-slate-100 outline-none transition placeholder:text-slate-500 focus:border-cyan focus:ring-2 focus:ring-cyan/35"
            />
          </label>

          <label class="block">
            <span class="text-sm font-bold text-slate-200">Email</span>
            <input
              type="email"
              name="email"
              placeholder="you@example.com"
              class="mt-2 min-h-12 w-full rounded border border-white/15 bg-black/40 px-4 text-slate-100 outline-none transition placeholder:text-slate-500 focus:border-cyan focus:ring-2 focus:ring-cyan/35"
            />
          </label>
        </div>

        <label class="mt-5 block">
          <span class="text-sm font-bold text-slate-200">Message</span>
          <textarea
            name="message"
            rows="6"
            placeholder="Tell me about the project..."
            class="mt-2 w-full rounded border border-white/15 bg-black/40 px-4 py-3 text-slate-100 outline-none transition placeholder:text-slate-500 focus:border-cyan focus:ring-2 focus:ring-cyan/35"
          ></textarea>
        </label>

        <button
          type="submit"
          class="mt-6 inline-flex min-h-12 w-full items-center justify-center gap-3 rounded border border-cyan/60 bg-cyan px-6 py-3 text-sm font-extrabold uppercase tracking-[0.14em] text-ink shadow-glow transition hover:-translate-y-1 hover:bg-cyan/90 focus:outline-none focus:ring-2 focus:ring-cyan focus:ring-offset-2 focus:ring-offset-panel sm:w-auto"
        >
          Send Message
          <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
        </button>

        <p id="form-note" class="mt-4 hidden text-sm font-medium text-mint">
          Placeholder form submitted locally. Backend logic will be wired in ASP.NET Core MVC.
        </p>
      </form>
    </div>
  </section>
</main>

<footer class="border-t border-white/10 px-5 py-8 sm:px-6 lg:px-8">
  <div class="mx-auto flex max-w-7xl flex-col gap-4 text-sm font-medium text-slate-400 sm:flex-row sm:items-center sm:justify-between">
    <p>&copy; <span id="current-year"></span> Paul Alarba. All rights reserved.</p>
    <p class="font-mono text-xs uppercase tracking-[0.22em] text-slate-500">Built for ASP.NET Core MVC integration</p>
  </div>
</footer>

<button
  id="back-to-top"
  type="button"
  class="back-to-top fixed bottom-5 right-5 z-40 inline-flex min-h-12 min-w-12 items-center justify-center rounded border border-cyan/45 bg-ink/90 text-cyan shadow-glow backdrop-blur-md transition hover:-translate-y-1 hover:bg-cyan hover:text-ink focus:outline-none focus:ring-2 focus:ring-cyan focus:ring-offset-2 focus:ring-offset-ink"
  aria-label="Back to top"
>
  <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
</button>
